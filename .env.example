# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://curex:curex123@localhost:5432/curex_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this-also
REFRESH_TOKEN_EXPIRES_IN=7d

# File Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=curex-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# External Services (set to 'mock' for demo mode)
DEMO_MODE=true
AI_PROVIDER=mock
OCR_PROVIDER=mock
SPEECH_PROVIDER=browser
ABDM_PROVIDER=mock

# AI Service Keys (only needed if not using mock)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Feature Flags
ENABLE_ABDM=true
ENABLE_AYUSH=true
ENABLE_RED_FLAGS=true
ENABLE_VOICE_INPUT=true

# Logging
LOG_LEVEL=info
